{
  "entities": {
    "Holding": {
      "title": "Holding",
      "description": "An equity holding in a user's NSE/BSE portfolio",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "symbol": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[A-Z0-9_&\\-\\.]+$"
        },
        "companyName": {
          "type": "string",
          "maxLength": 120
        },
        "exchange": {
          "type": "string",
          "enum": ["NSE", "BSE"]
        },
        "sector": {
          "type": "string",
          "maxLength": 64
        },
        "quantity": {
          "type": "number"
        },
        "avgBuyPrice": {
          "type": "number"
        },
        "buyDate": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "source": {
          "type": "string",
          "enum": ["manual", "screenshot", "signal"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "symbol",
        "companyName",
        "exchange",
        "sector",
        "quantity",
        "avgBuyPrice",
        "buyDate",
        "source",
        "createdAt",
        "updatedAt"
      ]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "A tracked NSE/BSE stock in a user's watchlist with optional price alert",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "symbol": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[A-Z0-9_&\\-\\.]+$"
        },
        "companyName": {
          "type": "string",
          "maxLength": 120
        },
        "exchange": {
          "type": "string",
          "enum": ["NSE", "BSE"]
        },
        "sector": {
          "type": "string",
          "maxLength": 64
        },
        "targetAlertPrice": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "symbol",
        "companyName",
        "exchange",
        "sector",
        "createdAt",
        "updatedAt"
      ]
    },
    "MutualFundHolding": {
      "title": "MutualFundHolding",
      "description": "An Indian mutual fund holding in a user's portfolio synced via AMFI scheme code",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "schemeCode": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[0-9]+$"
        },
        "schemeName": {
          "type": "string",
          "maxLength": 180
        },
        "fundHouse": {
          "type": "string",
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "maxLength": 80
        },
        "planType": {
          "type": "string",
          "enum": ["Direct", "Regular"]
        },
        "optionType": {
          "type": "string",
          "enum": ["Growth", "IDCW"]
        },
        "units": {
          "type": "number"
        },
        "avgNav": {
          "type": "number"
        },
        "purchaseDate": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "isSip": {
          "type": "boolean"
        },
        "monthlySipAmount": {
          "type": "number"
        },
        "folioNumber": {
          "type": "string",
          "maxLength": 40
        },
        "source": {
          "type": "string",
          "enum": ["manual", "screenshot", "cas_pdf"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "schemeCode",
        "schemeName",
        "fundHouse",
        "category",
        "planType",
        "optionType",
        "units",
        "avgNav",
        "purchaseDate",
        "isSip",
        "source",
        "createdAt",
        "updatedAt"
      ]
    },
    "AlgoStrategy": {
      "title": "AlgoStrategy",
      "description": "A user-defined or AI-compiled algorithmic paper trading strategy with risk guardrails",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "prompt": {
          "type": "string",
          "maxLength": 500
        },
        "summary": {
          "type": "string",
          "maxLength": 300
        },
        "symbols": {
          "type": "array",
          "description": "Target NSE/BSE equity symbols (1 to 10)"
        },
        "timeframe": {
          "type": "string",
          "enum": ["1d", "5d", "1mo", "6mo", "1y"]
        },
        "logicOperator": {
          "type": "string",
          "enum": ["AND", "OR"]
        },
        "entryConditions": {
          "type": "array",
          "description": "Compiled entry predicates (1 to 6)"
        },
        "exitConditions": {
          "type": "array",
          "description": "Compiled technical exit predicates (0 to 6)"
        },
        "virtualCapital": {
          "type": "number"
        },
        "allocationPercent": {
          "type": "number"
        },
        "stopLossPct": {
          "type": "number"
        },
        "takeProfitPct": {
          "type": "number"
        },
        "trailingStopPct": {
          "type": "number"
        },
        "maxOpenPositions": {
          "type": "number"
        },
        "dailyLossCapPct": {
          "type": "number"
        },
        "slippageBps": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "ACTIVE", "PAUSED", "PAUSED_RISK_CAP"]
        },
        "lastBacktestReturnPct": {
          "type": "number"
        },
        "lastBacktestSharpe": {
          "type": "number"
        },
        "lastBacktestMaxDrawdownPct": {
          "type": "number"
        },
        "lastBacktestWinRatePct": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "prompt",
        "summary",
        "symbols",
        "timeframe",
        "logicOperator",
        "entryConditions",
        "exitConditions",
        "virtualCapital",
        "allocationPercent",
        "stopLossPct",
        "takeProfitPct",
        "trailingStopPct",
        "maxOpenPositions",
        "dailyLossCapPct",
        "slippageBps",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AlgoOrder": {
      "title": "AlgoOrder",
      "description": "An immutable simulated paper-trade order or risk-guardrail block event",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "strategyId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "strategyName": {
          "type": "string",
          "maxLength": 100
        },
        "symbol": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[A-Z0-9_&\\-\\.]+$"
        },
        "side": {
          "type": "string",
          "enum": ["BUY", "SELL"]
        },
        "status": {
          "type": "string",
          "enum": ["FILLED", "BLOCKED_RISK_CAP", "BLOCKED_FUNDS", "CANCELLED"]
        },
        "quantity": {
          "type": "number"
        },
        "price": {
          "type": "number"
        },
        "notionalValue": {
          "type": "number"
        },
        "realizedPnl": {
          "type": "number"
        },
        "triggerReason": {
          "type": "string",
          "maxLength": 240
        },
        "executedAtIso": {
          "type": "string",
          "maxLength": 40
        },
        "tradingDate": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "strategyId",
        "strategyName",
        "symbol",
        "side",
        "status",
        "quantity",
        "price",
        "notionalValue",
        "realizedPnl",
        "triggerReason",
        "executedAtIso",
        "tradingDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "BacktestRun": {
      "title": "BacktestRun",
      "description": "An immutable snapshot of a 10-year historical backtest and confidence calibration run",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "methodology": {
          "type": "string",
          "enum": ["TECH_RECONSTRUCTED_V1"]
        },
        "universeMode": {
          "type": "string",
          "enum": ["portfolio_plus_flagship", "flagship", "portfolio_only"]
        },
        "samplingFrequency": {
          "type": "string",
          "enum": ["monthly", "biweekly", "weekly"]
        },
        "costBps": {
          "type": "number"
        },
        "trainCutoffDate": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "symbols": {
          "type": "array",
          "description": "Evaluated NSE/BSE symbols (1 to 30)"
        },
        "portfolioMetrics": {
          "type": "object"
        },
        "horizonSummaries": {
          "type": "array",
          "description": "Summary metrics for 1M, 3M, 6M, 1Y, 5Y, and 10Y horizons (1 to 6)"
        },
        "calibration3M": {
          "type": "object"
        },
        "calibration1Y": {
          "type": "object"
        },
        "stockScorecards": {
          "type": "array",
          "description": "Per-stock historical scorecards (1 to 30)"
        },
        "equityCurve": {
          "type": "array",
          "description": "Monthly indexed portfolio vs Nifty 50 equity curve points (0 to 140)"
        },
        "recentSignals": {
          "type": "array",
          "description": "Bounded audit sample of recent historical signals (0 to 150)"
        },
        "totalSignalsGenerated": {
          "type": "number"
        },
        "dataQuality": {
          "type": "array",
          "description": "Per-symbol data coverage and corporate action report (0 to 30)"
        },
        "computedAt": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "label",
        "methodology",
        "universeMode",
        "samplingFrequency",
        "costBps",
        "trainCutoffDate",
        "symbols",
        "portfolioMetrics",
        "horizonSummaries",
        "calibration3M",
        "calibration1Y",
        "stockScorecards",
        "equityCurve",
        "recentSignals",
        "totalSignalsGenerated",
        "dataQuality",
        "computedAt",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/holdings/{holdingId}": {
      "schema": { "$ref": "#/entities/Holding" },
      "description": "User-scoped NSE/BSE equity holdings"
    },
    "/users/{userId}/watchlist/{itemId}": {
      "schema": { "$ref": "#/entities/WatchlistItem" },
      "description": "User-scoped watchlist items and price alert thresholds"
    },
    "/users/{userId}/mutualFunds/{fundHoldingId}": {
      "schema": { "$ref": "#/entities/MutualFundHolding" },
      "description": "User-scoped Indian mutual fund holdings tracked by AMFI scheme code"
    },
    "/users/{userId}/algoStrategies/{strategyId}": {
      "schema": { "$ref": "#/entities/AlgoStrategy" },
      "description": "User-scoped algorithmic paper trading strategies and risk guardrails"
    },
    "/users/{userId}/algoOrders/{orderId}": {
      "schema": { "$ref": "#/entities/AlgoOrder" },
      "description": "User-scoped simulated paper-trade execution and risk-guardrail ledger"
    },
    "/users/{userId}/backtestRuns/{runId}": {
      "schema": { "$ref": "#/entities/BacktestRun" },
      "description": "User-scoped immutable 10-year historical backtesting and calibration snapshots"
    }
  }
}

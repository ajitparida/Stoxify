rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net — default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedEmail() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: Holding
    function isValidHolding(data) {
      return data.keys().hasAll([
          'id', 'userId', 'symbol', 'companyName', 'exchange',
          'sector', 'quantity', 'avgBuyPrice', 'buyDate', 'source',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'symbol', 'companyName', 'exchange',
          'sector', 'quantity', 'avgBuyPrice', 'buyDate', 'notes',
          'source', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 32 && data.symbol.matches('^[A-Z0-9_&\\-\\.]+$')
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 120
        && data.exchange in ['NSE', 'BSE']
        && data.sector is string && data.sector.size() >= 1 && data.sector.size() <= 64
        && data.quantity is number && data.quantity > 0 && data.quantity <= 10000000
        && data.avgBuyPrice is number && data.avgBuyPrice > 0 && data.avgBuyPrice <= 10000000
        && data.buyDate is string && data.buyDate.size() >= 10 && data.buyDate.size() <= 20 && data.buyDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.source in ['manual', 'screenshot', 'signal']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: WatchlistItem
    function isValidWatchlistItem(data) {
      return data.keys().hasAll([
          'id', 'userId', 'symbol', 'companyName', 'exchange',
          'sector', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'symbol', 'companyName', 'exchange',
          'sector', 'targetAlertPrice', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 32 && data.symbol.matches('^[A-Z0-9_&\\-\\.]+$')
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 120
        && data.exchange in ['NSE', 'BSE']
        && data.sector is string && data.sector.size() >= 1 && data.sector.size() <= 64
        && (!('targetAlertPrice' in data) || (data.targetAlertPrice is number && data.targetAlertPrice >= 0 && data.targetAlertPrice <= 10000000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: MutualFundHolding
    function isValidMutualFundHolding(data) {
      return data.keys().hasAll([
          'id', 'userId', 'schemeCode', 'schemeName', 'fundHouse',
          'category', 'planType', 'optionType', 'units', 'avgNav',
          'purchaseDate', 'isSip', 'source', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'schemeCode', 'schemeName', 'fundHouse',
          'category', 'planType', 'optionType', 'units', 'avgNav',
          'purchaseDate', 'isSip', 'monthlySipAmount', 'folioNumber',
          'source', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.schemeCode is string && data.schemeCode.size() >= 1 && data.schemeCode.size() <= 16 && data.schemeCode.matches('^[0-9]+$')
        && data.schemeName is string && data.schemeName.size() >= 1 && data.schemeName.size() <= 180
        && data.fundHouse is string && data.fundHouse.size() >= 1 && data.fundHouse.size() <= 100
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.planType in ['Direct', 'Regular']
        && data.optionType in ['Growth', 'IDCW']
        && data.units is number && data.units > 0 && data.units <= 10000000
        && data.avgNav is number && data.avgNav > 0 && data.avgNav <= 1000000
        && data.purchaseDate is string && data.purchaseDate.size() >= 10 && data.purchaseDate.size() <= 20 && data.purchaseDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.isSip is bool
        && (!('monthlySipAmount' in data) || (data.monthlySipAmount is number && data.monthlySipAmount >= 0 && data.monthlySipAmount <= 10000000))
        && (!('folioNumber' in data) || (data.folioNumber is string && data.folioNumber.size() <= 40))
        && data.source in ['manual', 'screenshot', 'cas_pdf']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: AlgoStrategy
    function isValidAlgoStrategy(data) {
      return data.keys().hasAll([
          'id', 'userId', 'name', 'prompt', 'summary', 'symbols',
          'timeframe', 'logicOperator', 'entryConditions', 'exitConditions',
          'virtualCapital', 'allocationPercent', 'stopLossPct', 'takeProfitPct',
          'trailingStopPct', 'maxOpenPositions', 'dailyLossCapPct', 'slippageBps',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'name', 'prompt', 'summary', 'symbols',
          'timeframe', 'logicOperator', 'entryConditions', 'exitConditions',
          'virtualCapital', 'allocationPercent', 'stopLossPct', 'takeProfitPct',
          'trailingStopPct', 'maxOpenPositions', 'dailyLossCapPct', 'slippageBps',
          'status', 'lastBacktestReturnPct', 'lastBacktestSharpe',
          'lastBacktestMaxDrawdownPct', 'lastBacktestWinRatePct',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 500
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300
        && data.symbols is list && data.symbols.size() >= 1 && data.symbols.size() <= 10 && data.symbols[0] is string && data.symbols[0].size() >= 1 && data.symbols[0].size() <= 32
        && data.timeframe in ['1d', '5d', '1mo', '6mo', '1y']
        && data.logicOperator in ['AND', 'OR']
        && data.entryConditions is list && data.entryConditions.size() >= 1 && data.entryConditions.size() <= 6 && data.entryConditions[0] is map
        && data.exitConditions is list && data.exitConditions.size() >= 0 && data.exitConditions.size() <= 6 && (data.exitConditions.size() == 0 || data.exitConditions[0] is map)
        && data.virtualCapital is number && data.virtualCapital >= 10000 && data.virtualCapital <= 100000000
        && data.allocationPercent is number && data.allocationPercent >= 5 && data.allocationPercent <= 100
        && data.stopLossPct is number && data.stopLossPct >= 0.5 && data.stopLossPct <= 50
        && data.takeProfitPct is number && data.takeProfitPct >= 0.5 && data.takeProfitPct <= 200
        && data.trailingStopPct is number && data.trailingStopPct >= 0 && data.trailingStopPct <= 50
        && data.maxOpenPositions is number && data.maxOpenPositions >= 1 && data.maxOpenPositions <= 20
        && data.dailyLossCapPct is number && data.dailyLossCapPct >= 0.5 && data.dailyLossCapPct <= 25
        && data.slippageBps is number && data.slippageBps >= 0 && data.slippageBps <= 100
        && data.status in ['DRAFT', 'ACTIVE', 'PAUSED', 'PAUSED_RISK_CAP']
        && (!('lastBacktestReturnPct' in data) || (data.lastBacktestReturnPct is number && data.lastBacktestReturnPct >= -100 && data.lastBacktestReturnPct <= 10000))
        && (!('lastBacktestSharpe' in data) || (data.lastBacktestSharpe is number && data.lastBacktestSharpe >= -20 && data.lastBacktestSharpe <= 50))
        && (!('lastBacktestMaxDrawdownPct' in data) || (data.lastBacktestMaxDrawdownPct is number && data.lastBacktestMaxDrawdownPct >= 0 && data.lastBacktestMaxDrawdownPct <= 100))
        && (!('lastBacktestWinRatePct' in data) || (data.lastBacktestWinRatePct is number && data.lastBacktestWinRatePct >= 0 && data.lastBacktestWinRatePct <= 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: AlgoOrder
    function isValidAlgoOrder(data) {
      return data.keys().hasAll([
          'id', 'userId', 'strategyId', 'strategyName', 'symbol',
          'side', 'status', 'quantity', 'price', 'notionalValue',
          'realizedPnl', 'triggerReason', 'executedAtIso', 'tradingDate',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'strategyId', 'strategyName', 'symbol',
          'side', 'status', 'quantity', 'price', 'notionalValue',
          'realizedPnl', 'triggerReason', 'executedAtIso', 'tradingDate',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && isValidId(data.strategyId)
        && data.userId == request.auth.uid
        && data.strategyName is string && data.strategyName.size() >= 1 && data.strategyName.size() <= 100
        && data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 32 && data.symbol.matches('^[A-Z0-9_&\\-\\.]+$')
        && data.side in ['BUY', 'SELL']
        && data.status in ['FILLED', 'BLOCKED_RISK_CAP', 'BLOCKED_FUNDS', 'CANCELLED']
        && data.quantity is number && data.quantity >= 0 && data.quantity <= 10000000
        && data.price is number && data.price > 0 && data.price <= 10000000
        && data.notionalValue is number && data.notionalValue >= 0 && data.notionalValue <= 1000000000
        && data.realizedPnl is number && data.realizedPnl >= -1000000000 && data.realizedPnl <= 1000000000
        && data.triggerReason is string && data.triggerReason.size() >= 1 && data.triggerReason.size() <= 240
        && data.executedAtIso is string && data.executedAtIso.size() >= 10 && data.executedAtIso.size() <= 40
        && data.tradingDate is string && data.tradingDate.size() >= 10 && data.tradingDate.size() <= 20 && data.tradingDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: BacktestRun
    function isValidBacktestRun(data) {
      return data.keys().hasAll([
          'id', 'userId', 'label', 'methodology', 'universeMode',
          'samplingFrequency', 'costBps', 'trainCutoffDate', 'symbols',
          'portfolioMetrics', 'horizonSummaries', 'calibration3M',
          'calibration1Y', 'stockScorecards', 'equityCurve',
          'recentSignals', 'totalSignalsGenerated', 'dataQuality',
          'computedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'label', 'methodology', 'universeMode',
          'samplingFrequency', 'costBps', 'trainCutoffDate', 'symbols',
          'portfolioMetrics', 'horizonSummaries', 'calibration3M',
          'calibration1Y', 'stockScorecards', 'equityCurve',
          'recentSignals', 'totalSignalsGenerated', 'dataQuality',
          'computedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 120
        && data.methodology in ['TECH_RECONSTRUCTED_V1']
        && data.universeMode in ['portfolio_plus_flagship', 'flagship', 'portfolio_only']
        && data.samplingFrequency in ['monthly', 'biweekly', 'weekly']
        && data.costBps is number && data.costBps >= 0 && data.costBps <= 100
        && data.trainCutoffDate is string && data.trainCutoffDate.size() >= 10 && data.trainCutoffDate.size() <= 20 && data.trainCutoffDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.symbols is list && data.symbols.size() >= 1 && data.symbols.size() <= 30 && data.symbols[0] is string && data.symbols[0].size() >= 1 && data.symbols[0].size() <= 32
        && data.portfolioMetrics is map
        && data.horizonSummaries is list && data.horizonSummaries.size() >= 1 && data.horizonSummaries.size() <= 6 && data.horizonSummaries[0] is map
        && data.calibration3M is map
        && data.calibration1Y is map
        && data.stockScorecards is list && data.stockScorecards.size() >= 1 && data.stockScorecards.size() <= 30 && data.stockScorecards[0] is map
        && data.equityCurve is list && data.equityCurve.size() >= 0 && data.equityCurve.size() <= 140 && (data.equityCurve.size() == 0 || data.equityCurve[0] is map)
        && data.recentSignals is list && data.recentSignals.size() >= 0 && data.recentSignals.size() <= 150 && (data.recentSignals.size() == 0 || data.recentSignals[0] is map)
        && data.totalSignalsGenerated is number && data.totalSignalsGenerated >= 0 && data.totalSignalsGenerated <= 200000
        && data.dataQuality is list && data.dataQuality.size() >= 0 && data.dataQuality.size() <= 30 && (data.dataQuality.size() == 0 || data.dataQuality[0] is map)
        && data.computedAt is string && data.computedAt.size() >= 10 && data.computedAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // User Holdings Collection
    match /users/{userId}/holdings/{holdingId} {
      allow get: if isVerifiedOwner(userId) && isValidId(holdingId) && existing().userId == request.auth.uid;
      allow list: if isVerifiedOwner(userId) && existing().userId == request.auth.uid;

      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(holdingId)
        && isValidHolding(incoming())
        && incoming().id == holdingId
        && incoming().userId == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(holdingId)
        && isValidHolding(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'avgBuyPrice', 'buyDate', 'notes', 'sector', 'updatedAt'])
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().symbol == existing().symbol
        && incoming().exchange == existing().exchange
        && incoming().source == existing().source
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isVerifiedOwner(userId) && isValidId(holdingId) && existing().userId == request.auth.uid;
    }

    // User Watchlist Collection
    match /users/{userId}/watchlist/{itemId} {
      allow get: if isVerifiedOwner(userId) && isValidId(itemId) && existing().userId == request.auth.uid;
      allow list: if isVerifiedOwner(userId) && existing().userId == request.auth.uid;

      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(itemId)
        && isValidWatchlistItem(incoming())
        && incoming().id == itemId
        && incoming().userId == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(itemId)
        && isValidWatchlistItem(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['targetAlertPrice', 'sector', 'updatedAt'])
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().symbol == existing().symbol
        && incoming().exchange == existing().exchange
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isVerifiedOwner(userId) && isValidId(itemId) && existing().userId == request.auth.uid;
    }

    // User Mutual Funds Collection
    match /users/{userId}/mutualFunds/{fundHoldingId} {
      allow get: if isVerifiedOwner(userId) && isValidId(fundHoldingId) && existing().userId == request.auth.uid;
      allow list: if isVerifiedOwner(userId) && existing().userId == request.auth.uid;

      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(fundHoldingId)
        && isValidMutualFundHolding(incoming())
        && incoming().id == fundHoldingId
        && incoming().userId == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(fundHoldingId)
        && isValidMutualFundHolding(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['units', 'avgNav', 'purchaseDate', 'isSip', 'monthlySipAmount', 'folioNumber', 'updatedAt'])
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().schemeCode == existing().schemeCode
        && incoming().schemeName == existing().schemeName
        && incoming().fundHouse == existing().fundHouse
        && incoming().category == existing().category
        && incoming().planType == existing().planType
        && incoming().optionType == existing().optionType
        && incoming().source == existing().source
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isVerifiedOwner(userId) && isValidId(fundHoldingId) && existing().userId == request.auth.uid;
    }

    // User Algo Strategies Collection
    match /users/{userId}/algoStrategies/{strategyId} {
      allow get: if isVerifiedOwner(userId) && isValidId(strategyId) && existing().userId == request.auth.uid;
      allow list: if isVerifiedOwner(userId) && existing().userId == request.auth.uid;

      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(strategyId)
        && isValidAlgoStrategy(incoming())
        && incoming().id == strategyId
        && incoming().userId == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(strategyId)
        && isValidAlgoStrategy(incoming())
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'prompt', 'summary', 'symbols', 'timeframe', 'logicOperator',
            'entryConditions', 'exitConditions', 'virtualCapital', 'allocationPercent',
            'stopLossPct', 'takeProfitPct', 'trailingStopPct', 'maxOpenPositions',
            'dailyLossCapPct', 'slippageBps', 'status', 'lastBacktestReturnPct',
            'lastBacktestSharpe', 'lastBacktestMaxDrawdownPct', 'lastBacktestWinRatePct',
            'updatedAt'
          ])
        )
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isVerifiedOwner(userId) && isValidId(strategyId) && existing().userId == request.auth.uid;
    }

    // User Algo Paper-Trade Orders Collection (Immutable Audit Ledger)
    match /users/{userId}/algoOrders/{orderId} {
      allow get: if isVerifiedOwner(userId) && isValidId(orderId) && existing().userId == request.auth.uid;
      allow list: if isVerifiedOwner(userId) && existing().userId == request.auth.uid;

      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(orderId)
        && isValidAlgoOrder(incoming())
        && incoming().id == orderId
        && incoming().userId == userId
        && exists(/databases/$(database)/documents/users/$(userId)/algoStrategies/$(incoming().strategyId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if false;

      allow delete: if isVerifiedOwner(userId) && isValidId(orderId) && existing().userId == request.auth.uid;
    }

    // User 10-Year Historical Backtest Runs Collection (Immutable Snapshots)
    match /users/{userId}/backtestRuns/{runId} {
      allow get: if isVerifiedOwner(userId) && isValidId(runId) && existing().userId == request.auth.uid;
      allow list: if isVerifiedOwner(userId) && existing().userId == request.auth.uid;

      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(runId)
        && isValidBacktestRun(incoming())
        && incoming().id == runId
        && incoming().userId == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if false;

      allow delete: if isVerifiedOwner(userId) && isValidId(runId) && existing().userId == request.auth.uid;
    }
  }
}
